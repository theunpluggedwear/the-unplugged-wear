# Safe placeholders only. Do not commit real secrets.
# See DOC/backend/23-Backend-Implementation.md section 9 for the full matrix.

# Neon Postgres (shared by tuw-admin and tuw-website). Server only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional pool tuning (defaults: 5 connections, 300000 ms idle).
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_MS=

# Session/JWT signing secret for this app (never shared with the browser).
# Must match tuw-admin AUTH_SECRET where tokens are read across apps.
AUTH_SECRET=
# Dev only: show verification/reset links on screen. Ignored in production.
AUTH_SHOW_DEV_LINKS=

# Admin -> POST /api/revalidate (header x-revalidate-secret).
# Must match the admin app's REVALIDATE_SECRET.
REVALIDATE_SECRET=

# Public URL of this deployment (email links, inventory alerts).
APP_URL=http://localhost:3007

# Transactional email used by heart adapters (auth, orders, alerts).
# Blank RESEND_API_KEY uses the durable local outbox. EMAIL_FROM must be a
# domain verified in Resend; EMAIL_PROVIDER overrides auto-selection.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_PROVIDER=

# Payments - blank runs the demo/sandbox checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
# PAYMENT_PROVIDER takes precedence over the admin "active payment provider"
# registry row: while it is set here, switching the provider in the admin app
# has no effect. Leave it unset to let staff choose the provider in admin.
# QA also forces 'mock' or 'razorpay' with this variable in integration tests.
PAYMENT_PROVIDER=razorpay

# Invoice provider is independent of the payment gateway. Leave unset to use
# the active `invoice` provider in the admin registry (razorpay_invoice).
INVOICE_PROVIDER=

# Build-time flag: 1 exposes /checklist and /design-system in production.
# Leave unset in deployed builds (both routes 404 by default).
TUW_INTERNAL_PAGES=
