# Safe placeholders only. Do not commit real secrets.

# Neon Postgres (shared by tuw-admin and tuw-website). Server only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Session/JWT signing secret for this app (never shared with the browser).
AUTH_SECRET=

# Admin -> POST /api/revalidate (header x-revalidate-secret).
REVALIDATE_SECRET=

# Public URL of this deployment (email links, inventory alerts).
APP_URL=http://localhost:3007

# Payments - blank runs the demo/sandbox checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PAYMENT_PROVIDER takes precedence over the admin "active payment provider"
# registry row: while it is set here, switching the provider in the admin app
# has no effect. Leave it unset to let staff choose the provider in admin.
# QA also forces 'mock' or 'razorpay' with this variable in integration tests.
PAYMENT_PROVIDER=razorpay

# Invoice provider is independent of the payment gateway. Leave unset to use
# the active `invoice` provider in the admin registry (razorpay_invoice).
INVOICE_PROVIDER=
CHECKOUT_TEST_MODE=false
CHECKOUT_TEST_SKU=
