{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/platform.sweepIdempotencyKeys",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/inventory.notifyRestocked",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/platform.sweepRateLimits",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/cron/fulfillment.submitDue",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/fulfillment.syncOpen",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/giftCards.expireDue",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/webhooks.retryFailed",
      "schedule": "30 4 * * *"
    }
  ]
}