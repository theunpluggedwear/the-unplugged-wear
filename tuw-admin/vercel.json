{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/platform.runDaily",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/platform.runUrgent",
      "schedule": "30 13 * * *"
    }
  ]
}
