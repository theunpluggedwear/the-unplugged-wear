{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/platform.sweepIdempotencyKeys",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/api/cron/inventory.notifyRestocked",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/platform.sweepRateLimits",
      "schedule": "45 21 * * *"
    },
    {
      "path": "/api/cron/fulfillment.submitDue",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/fulfillment.syncOpen",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/giftCards.expireDue",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/webhooks.retryFailed",
      "schedule": "30 4 * * *"
    },
    {
      "path": "/api/cron/payments.reconcileRazorpay",
      "schedule": "45 4 * * *"
    },
    {
      "path": "/api/cron/invoices.reconcileDocuments",
      "schedule": "50 4 * * *"
    },
    {
      "path": "/api/cron/analytics.detectAbandoned",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/analytics.rollupDaily",
      "schedule": "15 2 * * *"
    },
    {
      "path": "/api/cron/notifications.sendQueued",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/cron/notifications.pruneOld",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/cron/analytics.maintainPartitions",
      "schedule": "0 3 * * *"
    }
  ]
}