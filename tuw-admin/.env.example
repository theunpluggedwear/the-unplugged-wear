# Safe placeholders only. Do not commit real secrets.
# See DOC/backend/23-Backend-Implementation.md section 9 for the full matrix.

# Neon Postgres (shared by tuw-admin and tuw-website). Server only.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional pool tuning (defaults: 5 connections, 300000 ms idle).
DATABASE_POOL_MAX=
DATABASE_POOL_IDLE_MS=

# Session/JWT signing secret for this app (never shared with the browser).
# Must match tuw-website AUTH_SECRET where tokens are read across apps.
AUTH_SECRET=
# Dev only: show verification/reset links on screen. Ignored in production.
AUTH_SHOW_DEV_LINKS=

# Vercel Cron -> /api/cron/<job> (Authorization: Bearer $CRON_SECRET).
CRON_SECRET=

# Shared with the storefront: admin edits refresh storefront caches.
REVALIDATE_SECRET=

# Storefront origin used for revalidation calls and customer-facing links.
STOREFRONT_URL=http://localhost:3007

# Transactional email. Blank RESEND_API_KEY uses the durable local outbox.
# EMAIL_FROM must be a domain verified in Resend (gmail.com is not accepted).
# EMAIL_PROVIDER overrides auto-selection: resend | outbox. Leave blank to
# let the adapter with live keys win automatically.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_PROVIDER=

# Qikink print partner. Leave both blank to run the built-in simulator.
# QIKINK_BASE_URL is the canonical endpoint override. Deployments that still
# set the legacy QIKINK_ENDPOINT keep working as a fallback; when both are set,
# QIKINK_BASE_URL wins (qikinkConfig() in packages/heart reads both).
QIKINK_CLIENT_ID=
QIKINK_CLIENT_SECRET=
QIKINK_BASE_URL=
QIKINK_ENDPOINT=

# Payments - live Razorpay keys (server only; needed for admin refunds).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=

# PAYMENT_PROVIDER / INVOICE_PROVIDER override the admin provider registry.
# Leave blank to let staff switch providers in admin.
PAYMENT_PROVIDER=
INVOICE_PROVIDER=

# Kill switch: false blocks submission of paid orders to the partner.
FULFILLMENT_SUBMIT_ENABLED=true
